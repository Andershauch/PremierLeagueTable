# Keep source files normalized in Git regardless of local Windows defaults.
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary

# Bundled webfonts. Declared explicitly rather than left to git's content
# sniffing, because eol normalisation would silently corrupt a font file.
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
